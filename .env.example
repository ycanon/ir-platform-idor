# Configuración de IR Platform. Copie este archivo a `.env` y ajuste lo necesario; `.env` no se versiona.
# Todas las variables son opcionales: los valores por defecto sirven para el dataset del reto.

# --- Rutas (entorno virtual). En Docker se fijan en /data y /output. ---
IRP_DATA_DIR=data
IRP_OUTPUT_DIR=output

# --- Formato del log ---
IRP_CSV_SEPARATOR=,
# Formato strftime del timestamp. Vacío = AAAA-DD-MM (%Y-%d-%mT%H:%M, el del dataset del reto); "auto" = autodetección.
IRP_TIMESTAMP_FORMAT=

# --- Perfil del incidente ---
# auto (recomendado): se detecta del dataset en cada análisis. fixed: se usan siempre los valores de abajo.
IRP_PROFILE_MODE=auto
# Valores de respaldo (en modo auto solo se usan si no se detecta un endpoint con ID de objeto).
IRP_TARGET_ENDPOINT=/invoices/search
IRP_OBJECT_PARAM=invoice_id
# Parámetro de ámbito/tenant (vacío si el endpoint no lo tiene)
IRP_SCOPE_PARAM=site_id
IRP_TOKEN_PARAM=authtoken
# Cómo se nombran los objetos en los textos (evidencia, agentes, reglas)
IRP_OBJECT_LABEL=factura
IRP_OBJECT_LABEL_PLURAL=facturas
IRP_SCOPE_LABEL=sitio
# Fecha de detección por defecto para el TTD (vacío = se indica por análisis; sin fecha, el TTD se estima)
IRP_DETECTION_DATE=

# --- LLM de los agentes (opcional; sin LLM los agentes usan su lógica determinista) ---
# URL de Ollama. Por defecto: http://localhost:11434 en el entorno virtual y http://host.docker.internal:11434 en Docker.
# Con el perfil de Compose "ollama" use http://ollama:11434; para un servidor en la red, su URL (p. ej. http://10.0.0.20:11434).
# IRP_OLLAMA_BASE_URL=http://localhost:11434
IRP_OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M
# Conversación con los agentes: proveedor y modelo propios (vacío = los mismos de los agentes).
# Proveedores: ollama, openai_compatible, anthropic, openai, gemini, deepseek, mistral, groq, xai, openrouter.
# Las API keys de proveedores en la nube se ingresan en la interfaz (solo memoria).
IRP_CHAT_PROVIDER=
IRP_CHAT_MODEL=

IRP_LOG_LEVEL=INFO

# --- Web ---
# Tamaño máximo de carga por la web (MB)
IRP_MAX_UPLOAD_MB=2048
# Token de acceso a la UI (vacío = sin login; la app escucha solo en 127.0.0.1). Use un valor largo y aleatorio.
IRP_ACCESS_TOKEN=
# Token de SOLO LECTURA para /metrics. Si se define, /metrics exige "Authorization: Bearer <token>".
# Obligatorio con el perfil de Docker "observabilidad".
IRP_METRICS_TOKEN=

# --- Docker Compose (docs/DOCKER.md) ---
# Puertos locales de la UI y, con el perfil "observabilidad", de Prometheus y Grafana (siempre en 127.0.0.1).
IRP_PORT=8000
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
# Clave del usuario admin de Grafana (obligatoria con el perfil "observabilidad").
GRAFANA_ADMIN_PASSWORD=
# Imagen base de la plataforma (p. ej. el espejo de un registro interno).
# IRP_PYTHON_IMAGE=python:3.12-slim-bookworm
# Imagen de Ollama para el perfil "ollama" (fije una versión en producción).
# OLLAMA_IMAGE=ollama/ollama:latest
# Linux: uid/gid dueños de ./data y ./output (por defecto 10001). Use los suyos: `id -u` / `id -g`.
# IRP_UID=10001
# IRP_GID=10001

# --- Inteligencia de amenazas (opcional) ---
# Recomendado: ingresar las claves en la interfaz (solo memoria). Defínalas aquí solo para la CLI.
IRP_VT_API_KEY=
IRP_OTX_API_KEY=
IRP_VT_REQUESTS_PER_MINUTE=4
IRP_VT_DAILY_LIMIT=500
IRP_TI_CACHE_TTL_HOURS=24
# Fuentes del servidor MCP ti-gateway (docs/MCP.md). Ejemplo de MISP autoalojado:
# TI_MISP_URL=https://misp.example.internal
# TI_MISP_API_KEY=
# TI_MISP_CA_BUNDLE=/ruta/ca-interna.pem
